# ---------------------------------------------------------------
# Call Lagao: copy to .env and fill in. Never commit .env.
# All services (API, dashboard, voice worker) read this file.
# ---------------------------------------------------------------

# --- API (apps/api) ---
API_PORT=4000
# Public URL of the API (used by the voice worker to reach /internal/*)
API_BASE_URL=http://localhost:4000
# Dashboard origin (CORS). An https:// origin also makes session cookies Secure.
WEB_ORIGIN=http://localhost:3000
# Postgres connection string. Leave empty to use the embedded PGlite database in .data/ (dev only).
DATABASE_URL=
# REQUIRED. Shared secret between the API and the voice worker, at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=
# Who may create accounts: "first" (default, only until the first account exists), "true" (anyone), "false" (nobody)
ALLOW_SIGNUP=first
# Set to "production" when deploying: refuses weak secrets and marks cookies Secure.
# NODE_ENV=production
# Local development only: let webhooks and custom tools call localhost / private IPs.
# Never enable this on a server that untrusted users can sign up to.
# ALLOW_PRIVATE_URLS=true

# --- LiveKit (https://cloud.livekit.io → project → Settings → Keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Name the voice worker registers with (must be the same for API and worker)
LIVEKIT_AGENT_NAME=call-lagao-agent
# Optional: outbound SIP trunk id for phone calls (LiveKit SIP + Twilio/Telnyx trunk)
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# --- Model providers (voice worker + post-call analysis) ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
CARTESIA_API_KEY=

# --- Voice worker tuning (apps/voice, optional) ---
# End-of-turn detector: multilingual (default) | inference | vad | stt
TURN_DETECTOR=
# Seconds to wait for the caller to join before reporting dial_no_answer
CALL_JOIN_TIMEOUT_S=120
# Windows only: set to 1 to disable the MSVC runtime workaround in _winfix.py
# CALL_LAGAO_NO_VCRT_SHIM=1

# --- Dashboard (apps/web) ---
# Where the Next.js server proxies /api/v1/* to (read at build and dev time)
API_INTERNAL_URL=http://localhost:4000
