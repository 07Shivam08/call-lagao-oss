{
  "name": "@call-lagao/web-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Browser SDK for Call Lagao web calls (LiveKit-based).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "livekit-client": "^2.23.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/07Shivam08/call-lagao-oss.git",
    "directory": "packages/web-sdk"
  }
}
